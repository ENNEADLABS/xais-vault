# ─── Supabase ────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ─── LLM Providers ──────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...

# ─── Web Search (Agent Researcher) ──────────────
TAVILY_API_KEY=tvly-...

# ─── App ────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development

# ─── Feature Flags ────────────────────────────────
AUTO_SCAN_ENABLED=false  # true = scan auto dès que toutes les sources sont prêtes

# ─── Admin (comma-separated UUIDs) ──────────────
ADMIN_USER_IDS=

# ─── Sentry (optional) ─────────────────────────
SENTRY_DSN=

# ─── Frontend (.env.local) ─────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_API_URL=http://localhost:8000

  # ─── Stripe ───────────────────────────────────────────────────────────────────                                                                                                              
  # Clé secrète Stripe (sk_test_... pour test, sk_live_... pour prod)                                                                                                                           
  STRIPE_SECRET_KEY=sk_test_                                                                                                                                                                    
                                                                                                                                                                                                
  # Secret pour valider les webhooks Stripe (Dashboard → Webhooks → Signing secret)                                                                                                             
  STRIPE_WEBHOOK_SECRET=whsec_                                                                                                                                                                  
                                                                                                                                                                                                
  # Price IDs des 3 plans (Dashboard → Products → Prix)                                                                                                                                         
  STRIPE_PRICE_STARTER=price_                                                                                                                                                                   
  STRIPE_PRICE_PREMIUM=price_                                                                                                                                                                   
  STRIPE_PRICE_TEAM=price_                                                                                                                                                                      
                             