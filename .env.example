# Supabase — values are printed by `supabase status` for local development.
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
SUPABASE_JWT_SECRET=your-local-jwt-secret
XAIS_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# Core AI providers. Real credentials are required at application startup.
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...
TAVILY_API_KEY=tvly-...

# Optional integrations.
SENTRY_DSN=
REDIS_URL=redis://redis:6379

# Application.
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development
AUTO_SCAN_ENABLED=false
ADMIN_USER_IDS=
HEALTH_SECRET=

# Frontend. These values mirror the local Supabase and API URLs above.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional Stripe billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_TEAM=
NEXT_PUBLIC_STRIPE_PRICE_STARTER=
NEXT_PUBLIC_STRIPE_PRICE_PREMIUM=
NEXT_PUBLIC_STRIPE_PRICE_TEAM=
NEXT_PUBLIC_STRIPE_PRICE_STARTER_YEARLY=
NEXT_PUBLIC_STRIPE_PRICE_PREMIUM_YEARLY=
NEXT_PUBLIC_STRIPE_PRICE_TEAM_YEARLY=
